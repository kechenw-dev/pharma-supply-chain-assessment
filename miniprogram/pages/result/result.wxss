.result-page { padding-top: 20rpx; }
.result-hero { padding: 37rpx 32rpx 33rpx; border-radius: 30rpx; color: #fff; background: linear-gradient(145deg, #12233B, #0E5366); }
.result-eyebrow { color: #80DBDE; font-size: 19rpx; font-weight: 700; letter-spacing: 2rpx; }
.result-title { margin-top: 18rpx; font-size: 45rpx; font-weight: 700; }
.result-company { margin-top: 10rpx; color: #C5DEE5; font-size: 23rpx; }
.result-summary { display: flex; align-items: flex-end; margin-top: 38rpx; padding: 23rpx 0 21rpx; border-top: 1rpx solid rgba(216, 241, 246, .25); border-bottom: 1rpx solid rgba(216, 241, 246, .25); }
.summary-main { flex: 1; }
.summary-number { color: #fff; font-size: 43rpx; font-weight: 700; line-height: 1.2; }
.summary-label { margin-top: 10rpx; color: #C9E4E9; font-size: 20rpx; line-height: 1.4; }
.summary-side { min-width: 81rpx; margin-left: 17rpx; text-align: center; }
.summary-small { color: #91E7E5; font-size: 34rpx; font-weight: 700; }
.summary-side-label { color: #C6DDE4; font-size: 19rpx; white-space: nowrap; }
.summary-note { margin-top: 17rpx; color: #C2DAE1; font-size: 21rpx; line-height: 1.5; }
.attention-card { display: flex; margin-top: 20rpx; padding: 24rpx; border-radius: 21rpx; background: #FFF2E9; }
.attention-mark { display: flex; align-items: center; justify-content: center; flex: none; width: 39rpx; height: 39rpx; margin-right: 16rpx; border-radius: 50%; background: #D27541; color: #fff; font-size: 25rpx; font-weight: 700; }
.attention-title { color: #84451F; font-size: 26rpx; font-weight: 700; }
.attention-text { margin-top: 9rpx; color: #80573C; font-size: 23rpx; line-height: 1.6; }
.result-section-head { display: flex; align-items: flex-end; justify-content: space-between; margin: 44rpx 4rpx 20rpx; }
.green { color: #0B8893; }
.result-section-title { margin-top: 8rpx; color: #193548; font-size: 33rpx; font-weight: 700; }
.result-count { color: #8CA5AC; font-size: 27rpx; font-weight: 700; }
.priority-card { padding: 5rpx 27rpx; border: 1rpx solid #DFE9EB; border-radius: 23rpx; background: #fff; }
.priority-item { padding: 25rpx 0; border-top: 1rpx solid #E8EFF0; }
.priority-item:first-child { border-top: 0; }
.priority-top { display: flex; align-items: center; }
.priority-number { display: flex; align-items: center; justify-content: center; width: 37rpx; height: 37rpx; margin-right: 15rpx; border-radius: 11rpx; background: #0B8993; color: #fff; font-size: 21rpx; font-weight: 700; }
.priority-title { color: #17374A; font-size: 26rpx; font-weight: 700; }
.priority-hook { margin-top: 13rpx; color: #405B68; font-size: 24rpx; line-height: 1.65; }
.priority-action { margin-top: 17rpx; padding: 16rpx 18rpx; border-radius: 15rpx; background: #EAF7F7; color: #366771; font-size: 23rpx; line-height: 1.6; }
.priority-action-label { color: #087984; font-size: 21rpx; font-weight: 700; }
.dimension-card { margin-bottom: 13rpx; padding: 24rpx 27rpx; border: 1rpx solid #DFE9EB; border-radius: 22rpx; background: #fff; }
.dimension-header { display: flex; align-items: center; }
.dimension-number { margin-right: 15rpx; color: #0B8D99; font-size: 22rpx; font-weight: 700; }
.dimension-name { flex: 1; color: #1C394A; font-size: 26rpx; font-weight: 700; }
.dimension-chevron { color: #7A969E; font-size: 27rpx; }
.dimension-status { display: inline-block; margin-top: 13rpx; padding: 6rpx 14rpx; border-radius: 999rpx; font-size: 21rpx; }
.state-stable { color: #087E67; background: #E1F5E9; }
.state-uneven, .state-personal { color: #9C641C; background: #FFF2D9; }
.state-missing { color: #A44632; background: #FCEAE5; }
.state-unknown { color: #667B78; background: #EEF2F1; }
.dimension-detail { margin-top: 17rpx; padding-top: 17rpx; border-top: 1rpx solid #E8EFF0; }
.dimension-hook { color: #405B68; font-size: 23rpx; line-height: 1.6; }
.dimension-action { display: flex; margin-top: 13rpx; padding: 14rpx 17rpx; border-radius: 14rpx; background: #EDF7F5; color: #376D68; font-size: 22rpx; line-height: 1.6; }
.action-dot { margin-right: 10rpx; color: #0B9D9F; font-size: 15rpx; }
.dimension-unknown { margin-top: 11rpx; color: #748A90; font-size: 22rpx; line-height: 1.5; }
.result-cta { margin-top: 34rpx; padding: 29rpx; border-radius: 24rpx; background: #E5F4F5; }
.result-cta-title { color: #173A4C; font-size: 30rpx; font-weight: 700; }
.result-cta-text { margin-top: 9rpx; color: #5D7983; font-size: 23rpx; line-height: 1.6; }
