.result-page { padding-top: 20rpx; }
.result-hero { border-radius: 31rpx; padding: 38rpx 34rpx 34rpx; color: #fff; background: linear-gradient(145deg, #123238, #0C625A); }
.result-eyebrow { color: #B8EBD4; font-size: 19rpx; font-weight: 700; letter-spacing: 3rpx; }
.result-title { margin-top: 20rpx; font-size: 47rpx; line-height: 1.25; font-weight: 700; }
.result-company { margin-top: 12rpx; color: #D1E8E1; font-size: 24rpx; }
.result-summary { margin-top: 38rpx; padding: 26rpx; border: 1rpx solid rgba(229, 255, 243, .25); border-radius: 22rpx; background: rgba(255, 255, 255, .10); }
.summary-label { color: #C7E6DA; font-size: 23rpx; }
.summary-number { margin-top: 10rpx; font-size: 33rpx; font-weight: 700; line-height: 1.45; }
.summary-note { margin-top: 10rpx; color: #D0E9E0; font-size: 22rpx; }
.attention-card { display: flex; margin-top: 24rpx; padding: 26rpx; border-radius: 22rpx; background: #FFF3E6; }
.attention-mark { display: flex; flex: none; align-items: center; justify-content: center; width: 39rpx; height: 39rpx; margin-right: 17rpx; border-radius: 50%; background: #C76A35; color: #fff; font-size: 25rpx; font-weight: 700; }
.attention-title { color: #844521; font-size: 27rpx; font-weight: 700; }
.attention-text { margin-top: 9rpx; color: #80573C; font-size: 23rpx; line-height: 1.6; }
.result-section-head { display: flex; align-items: flex-end; justify-content: space-between; margin: 44rpx 5rpx 21rpx; }
.green { color: #078C7D; }
.result-section-title { margin-top: 8rpx; font-size: 34rpx; font-weight: 700; }
.result-count { color: #91B5A3; font-size: 29rpx; font-weight: 700; }
.dimension-card { margin-bottom: 14rpx; padding: 28rpx; border: 1rpx solid #E4EDE8; border-radius: 24rpx; background: #fff; }
.dimension-header { display: flex; align-items: center; }
.dimension-number { margin-right: 17rpx; color: #11A08B; font-size: 25rpx; font-weight: 700; }
.dimension-name { font-size: 29rpx; font-weight: 700; }
.dimension-status { display: inline-block; margin-top: 16rpx; padding: 7rpx 15rpx; border-radius: 999rpx; font-size: 22rpx; }
.state-stable { color: #087E67; background: #E1F5E9; }
.state-uneven, .state-personal { color: #9C641C; background: #FFF2D9; }
.state-missing { color: #A44632; background: #FCEAE5; }
.state-unknown { color: #667B78; background: #EEF2F1; }
.dimension-hook { margin-top: 17rpx; font-size: 25rpx; line-height: 1.65; }
.dimension-action { display: flex; margin-top: 16rpx; padding: 16rpx 19rpx; border-radius: 15rpx; background: #F1F8F4; color: #2F6759; font-size: 23rpx; line-height: 1.6; }
.action-dot { margin-right: 11rpx; color: #0B9D80; font-size: 16rpx; }
.dimension-unknown { margin-top: 13rpx; color: #80918B; font-size: 22rpx; }
.finding-card { padding-top: 9rpx; padding-bottom: 9rpx; }
.finding { padding: 23rpx 0; border-top: 1rpx solid #E8EFEB; }
.finding:first-child { border-top: 0; }
.finding-top { display: flex; align-items: center; }
.finding-index { display: flex; align-items: center; justify-content: center; width: 35rpx; height: 35rpx; margin-right: 14rpx; border-radius: 10rpx; color: #fff; background: #0B8D7A; font-size: 21rpx; }
.finding-title { font-weight: 700; font-size: 26rpx; }
.finding-hook { margin-top: 14rpx; font-size: 25rpx; line-height: 1.6; }
.finding-action { margin-top: 10rpx; color: #52766A; font-size: 23rpx; line-height: 1.6; }
.result-cta { margin-top: 32rpx; padding: 30rpx; border-radius: 25rpx; background: #E3F3EA; }
.result-cta-title { font-size: 30rpx; font-weight: 700; }
.result-cta-text { margin-top: 8rpx; color: #5A786C; font-size: 24rpx; line-height: 1.6; }
