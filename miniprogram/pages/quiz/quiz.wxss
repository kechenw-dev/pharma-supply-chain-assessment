.quiz-top { display: flex; justify-content: space-between; align-items: center; margin: 16rpx 2rpx 18rpx; }
.quiz-eyebrow { color: #087E73; font-size: 25rpx; font-weight: 700; }
.quiz-progress { color: #6E857B; font-size: 24rpx; }
.progress-track { height: 10rpx; margin-bottom: 30rpx; border-radius: 999rpx; background: #DBEAE2; overflow: hidden; }
.progress-fill { height: 100%; border-radius: 999rpx; background: #0C9B86; }
.question-number { color: #0B9987; font-size: 20rpx; font-weight: 700; letter-spacing: 2rpx; }
.question-title { margin: 17rpx 0 26rpx; line-height: 1.45; }
.option { display: flex; align-items: flex-start; border: 1rpx solid #DDEAE3; border-radius: 17rpx; padding: 22rpx; margin: 16rpx 0; font-size: 27rpx; line-height: 1.5; }
.option-radio { flex: none; width: 25rpx; height: 25rpx; margin: 8rpx 18rpx 0 0; border: 2rpx solid #A9BDB4; border-radius: 50%; }
.option-active { border-color: #0A907E; color: #075F55; background: #E8F6EE; font-weight: 600; }
.option-active .option-radio { border-color: #0A907E; background: #0A907E; box-shadow: inset 0 0 0 5rpx #E8F6EE; }
