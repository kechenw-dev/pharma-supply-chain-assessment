.quiz-top { display: flex; justify-content: space-between; align-items: center; margin: 16rpx 2rpx 18rpx; }
.quiz-eyebrow { color: #0B8491; font-size: 25rpx; font-weight: 700; }
.quiz-progress { color: #6E857B; font-size: 24rpx; }
.progress-track { height: 10rpx; margin-bottom: 30rpx; border-radius: 999rpx; background: #DDECEF; overflow: hidden; }
.progress-fill { height: 100%; border-radius: 999rpx; background: #0B9BA8; }
.guide-card { display: flex; margin-bottom: 23rpx; padding: 23rpx; border-radius: 20rpx; background: #E9F6F7; }
.guide-icon { display: flex; align-items: center; justify-content: center; flex: none; width: 38rpx; height: 38rpx; margin-right: 15rpx; border-radius: 11rpx; background: #1599A4; color: #fff; font-size: 24rpx; }
.guide-title { color: #096B78; font-size: 22rpx; font-weight: 700; }
.guide-text { margin-top: 7rpx; color: #496E76; font-size: 23rpx; line-height: 1.6; }
.question-number { color: #0B8995; font-size: 20rpx; font-weight: 700; letter-spacing: 2rpx; }
.question-title { margin: 17rpx 0 26rpx; line-height: 1.45; }
.option { display: flex; align-items: flex-start; border: 1rpx solid #DDE8EB; border-radius: 17rpx; padding: 22rpx; margin: 16rpx 0; font-size: 27rpx; line-height: 1.5; }
.option-radio { flex: none; width: 25rpx; height: 25rpx; margin: 8rpx 18rpx 0 0; border: 2rpx solid #A9BDB4; border-radius: 50%; }
.option-active { border-color: #0B98A1; color: #075E69; background: #E9F8F8; font-weight: 600; }
.option-active .option-radio { border-color: #0B98A1; background: #0B98A1; box-shadow: inset 0 0 0 5rpx #E9F8F8; }
