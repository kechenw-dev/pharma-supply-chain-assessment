<view class="page">
  <view class="quiz-top"><view class="quiz-eyebrow">{{dimension}}</view><view class="quiz-progress">{{progress}}</view></view>
  <view class="progress-track"><view class="progress-fill" style="width: {{progressPercent}}%;"></view></view>
  <view class="guide-card"><view class="guide-icon">✦</view><view><view class="guide-title">从真实工作里找答案</view><view class="guide-text">{{guide}}</view></view></view>
  <view class="card">
    <view class="question-number">核查点 {{progress}}</view>
    <view class="section-title question-title">{{current.text}}</view>
    <view class="option {{selected == item.value ? 'option-active' : ''}}" wx:for="{{options}}" wx:key="value" data-value="{{item.value}}" bindtap="choose"><view class="option-radio"></view><view>{{item.label}}</view></view>
  </view>
  <button class="btn-primary" bindtap="next">{{index + 1 == questions.length ? '完成答题' : '下一题'}}</button>
  <button wx:if="{{index > 0}}" class="btn-plain" bindtap="previous">上一题</button>
  <view class="footer-note">“不清楚”不会被判定为企业缺少机制，只会降低本次结论的把握度。</view>
</view>
