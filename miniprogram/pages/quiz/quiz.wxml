<view class="page">
  <view class="row"><view class="tag">{{dimension}}</view><view class="muted">{{progress}}</view></view>
  <view class="card">
    <view class="section-title">{{current.text}}</view>
    <view class="option {{selected == item.value ? 'option-active' : ''}}" wx:for="{{options}}" wx:key="value" data-value="{{item.value}}" bindtap="choose">{{item.label}}</view>
  </view>
  <button class="btn-primary" bindtap="next">{{index + 1 == questions.length ? '完成答题' : '下一题'}}</button>
  <button wx:if="{{index > 0}}" class="btn-plain" bindtap="previous">上一题</button>
  <view class="footer-note">“不清楚”不会被判定为企业缺少机制，只会降低本次结论的把握度。</view>
</view>
