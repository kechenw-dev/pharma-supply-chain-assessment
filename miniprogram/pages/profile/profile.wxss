.profile-page { padding-top: 22rpx; }
.profile-top { padding: 33rpx 30rpx 38rpx; border-radius: 28rpx; background: linear-gradient(145deg, #12233B, #105469); color: #fff; }
.profile-step { color: #74DADC; font-size: 22rpx; font-weight: 700; letter-spacing: 2rpx; }
.profile-title { margin-top: 29rpx; font-size: 45rpx; line-height: 1.36; font-weight: 700; }
.profile-sub { margin-top: 15rpx; color: #C5DDE5; font-size: 24rpx; line-height: 1.65; }
.focus-note { display: flex; align-items: center; margin-top: 18rpx; padding: 20rpx; border-radius: 17rpx; background: #E5F8F6; color: #0E7881; font-size: 23rpx; line-height: 1.5; }
.focus-dot { flex: none; width: 12rpx; height: 12rpx; margin-right: 14rpx; border-radius: 50%; background: #15B5B1; }
.profile-section { margin-top: 36rpx; }
.profile-section-title { color: #1B3546; font-size: 30rpx; font-weight: 700; }
.profile-section-sub { margin: 7rpx 0 18rpx; color: #71838B; font-size: 23rpx; }
.business-item { display: flex; align-items: center; margin-bottom: 11rpx; padding: 19rpx 21rpx; border: 1rpx solid #DDE8EB; border-radius: 17rpx; background: #fff; }
.business-marker { display: flex; align-items: center; justify-content: center; flex: none; width: 38rpx; height: 38rpx; margin-right: 17rpx; border-radius: 11rpx; background: #EEF3F5; color: #6D8590; font-size: 22rpx; font-weight: 700; }
.business-label { flex: 1; font-size: 25rpx; line-height: 1.4; }
.selection-dot { flex: none; width: 22rpx; height: 22rpx; margin-left: 12rpx; border: 2rpx solid #B8C8CC; border-radius: 50%; }
.item-selected { border-color: #0B98A1; background: #E9F8F7; }
.item-selected .business-marker { background: #0A929A; color: #fff; }
.item-selected .selection-dot { border-color: #0A929A; background: #0A929A; box-shadow: inset 0 0 0 5rpx #E9F8F7; }
.role-list { display: flex; flex-wrap: wrap; }
.role-item { box-sizing: border-box; width: 49%; margin: 0 2% 11rpx 0; padding: 19rpx 15rpx; border: 1rpx solid #DDE8EB; border-radius: 16rpx; background: #fff; color: #3E5762; font-size: 23rpx; text-align: center; }
.role-item:nth-child(2n) { margin-right: 0; }
.role-selected { border-color: #0B98A1; background: #E9F8F7; color: #067A83; font-weight: 700; }
.profile-next { margin-top: 30rpx; }
