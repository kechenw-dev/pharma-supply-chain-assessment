<view class="page" wx:if="{{lead}}"><view class="hero"><view class="hero-title">{{lead.companyName}}</view><view class="hero-sub">{{lead.contactName}} · {{lead.jobTitle}} · {{lead.phone}}</view></view>
  <view class="card"><view class="section-title">回访</view><button class="btn-secondary" bindtap="call">拨打电话</button><view class="field-label">跟进状态</view><picker range="{{states}}" range-key="label" value="{{statusIndex}}" bindchange="pick"><view class="field-input">{{states[statusIndex].label}}</view></picker><view class="field-label">本次记录</view><textarea class="field-textarea" value="{{note}}" bindinput="input" placeholder="记录解读、需求和下一步；客户拒绝联系时选择对应状态"/><button class="btn-primary" loading="{{busy}}" bindtap="save">保存跟进</button></view>
  <view class="card"><view class="section-title">体检结论</view><view class="muted">{{lead.result.disclaimer}}</view><view wx:for="{{lead.result.findings}}" wx:key="dimension" class="body">{{item.dimension}}：{{item.hook}}</view></view>
</view>
