.home-page { padding-top: 20rpx; }
.home-hero { overflow: hidden; padding: 39rpx 34rpx 34rpx; border-radius: 32rpx; color: #fff; background: linear-gradient(145deg, #101E36, #123B55 70%, #096F78); box-shadow: 0 20rpx 40rpx rgba(20, 55, 79, .19); }
.home-brand { display: flex; align-items: center; color: #C9E8F0; font-size: 22rpx; font-weight: 600; }
.brand-mark { display: flex; align-items: center; justify-content: center; width: 39rpx; height: 39rpx; margin-right: 13rpx; border-radius: 11rpx; background: #36C8C5; color: #0B273A; font-weight: 800; }
.hero-kicker { display: inline-block; margin-top: 43rpx; padding: 8rpx 17rpx; border: 1rpx solid rgba(133, 228, 233, .45); border-radius: 999rpx; color: #8BE4E7; font-size: 21rpx; letter-spacing: 2rpx; }
.home-headline { margin-top: 24rpx; font-size: 53rpx; line-height: 1.3; font-weight: 700; letter-spacing: 1rpx; }
.home-lead { max-width: 570rpx; margin-top: 17rpx; color: #C6DBE4; font-size: 25rpx; line-height: 1.65; }
.chain-map { display: flex; align-items: flex-start; margin-top: 41rpx; padding: 25rpx 5rpx 0; border-top: 1rpx solid rgba(215, 242, 244, .22); }
.chain-node { display: flex; flex-direction: column; align-items: center; color: #D7EFF0; font-size: 20rpx; white-space: nowrap; }
.chain-dot { width: 17rpx; height: 17rpx; margin-bottom: 11rpx; border-radius: 50%; background: #3CDBD0; box-shadow: 0 0 0 7rpx rgba(60, 219, 208, .14); }
.chain-line { flex: 1; height: 2rpx; margin: 8rpx 10rpx 0; background: rgba(96, 218, 219, .54); }
.resume-card { display: flex; justify-content: space-between; align-items: center; margin-top: 20rpx; padding: 22rpx 27rpx; border: 1rpx solid #B7E6E4; border-radius: 21rpx; background: #E2F8F5; }
.resume-eyebrow { color: #007D85; font-size: 21rpx; font-weight: 700; }
.resume-title { margin-top: 7rpx; font-size: 27rpx; font-weight: 700; }
.resume-arrow { color: #087E84; font-size: 34rpx; }
.home-section-heading { display: flex; justify-content: space-between; align-items: flex-end; margin: 46rpx 5rpx 16rpx; }
.home-eyebrow { color: #0B8691; font-size: 18rpx; font-weight: 700; letter-spacing: 2rpx; }
.home-section-title { margin-top: 9rpx; color: #132B3F; font-size: 35rpx; font-weight: 700; }
.section-helper { margin: 0 5rpx 22rpx; color: #687E87; font-size: 23rpx; line-height: 1.6; }
.scene-grid { display: flex; flex-wrap: wrap; justify-content: space-between; }
.scene-card { display: flex; flex-direction: column; box-sizing: border-box; width: 49%; min-height: 274rpx; margin-bottom: 15rpx; padding: 23rpx; border: 1rpx solid #DEE9EB; border-radius: 24rpx; background: #fff; }
.scene-top { display: flex; justify-content: space-between; align-items: center; }
.scene-number { color: #91A4AD; font-size: 22rpx; font-weight: 700; }
.scene-icon { display: flex; align-items: center; justify-content: center; width: 44rpx; height: 44rpx; border-radius: 13rpx; background: #E3F8F6; color: #078C94; font-size: 27rpx; }
.scene-planning .scene-icon { background: #FFF2DF; color: #B87420; }
.scene-inventory .scene-icon { background: #E7EEFF; color: #526FC5; }
.scene-quality .scene-icon { background: #FCEAE8; color: #BE6250; }
.scene-title { margin-top: 17rpx; color: #19374A; font-size: 26rpx; font-weight: 700; line-height: 1.35; }
.scene-desc { margin-top: 9rpx; color: #6B7E87; font-size: 21rpx; line-height: 1.5; }
.scene-link { display: flex; justify-content: space-between; margin-top: auto; padding-top: 20rpx; color: #087C88; font-size: 21rpx; font-weight: 700; }
.scene-link text { font-size: 26rpx; }
.full-check-card { display: flex; align-items: center; margin-top: 10rpx; padding: 24rpx; border-radius: 23rpx; background: #173B50; color: #fff; }
.full-check-icon { display: flex; align-items: center; justify-content: center; flex: none; width: 57rpx; height: 57rpx; margin-right: 19rpx; border-radius: 16rpx; background: #2BAFBA; font-size: 39rpx; }
.full-check-main { flex: 1; }
.full-check-title { font-size: 27rpx; font-weight: 700; }
.full-check-desc { margin-top: 5rpx; color: #C5DFE4; font-size: 21rpx; }
.full-check-arrow { color: #7BE2E3; font-size: 31rpx; }
.journey-card { padding: 5rpx 26rpx; border: 1rpx solid #E1EAEC; border-radius: 24rpx; background: #fff; }
.journey-step { display: flex; padding: 21rpx 0; border-top: 1rpx solid #E8EFF0; }
.journey-step:first-child { border-top: 0; }
.journey-index { display: flex; align-items: center; justify-content: center; flex: none; width: 38rpx; height: 38rpx; margin-right: 20rpx; border-radius: 12rpx; background: #E0F5F5; color: #087F89; font-size: 22rpx; font-weight: 700; }
.journey-title { color: #19384A; font-size: 25rpx; font-weight: 700; }
.journey-desc { margin-top: 5rpx; color: #6B8088; font-size: 22rpx; line-height: 1.5; }
.home-actions { display: flex; margin-top: 31rpx; }
.action-tile { position: relative; box-sizing: border-box; width: 50%; min-height: 165rpx; padding: 22rpx; border: 1rpx solid #E0E9EB; border-radius: 23rpx; background: #fff; }
.action-tile:first-child { margin-right: 16rpx; }
.tile-icon { color: #0B919B; font-size: 30rpx; }
.tile-title { margin-top: 9rpx; font-size: 26rpx; font-weight: 700; }
.tile-sub { margin-top: 5rpx; color: #74878E; font-size: 21rpx; }
.tile-arrow { position: absolute; right: 20rpx; top: 17rpx; color: #8EADB2; font-size: 25rpx; }
