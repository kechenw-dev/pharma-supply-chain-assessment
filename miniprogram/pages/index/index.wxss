.home-page { padding-top: 20rpx; }
.home-hero { position: relative; overflow: hidden; padding: 38rpx; border-radius: 32rpx; color: #fff; background: linear-gradient(135deg, #123238, #105F5B 78%, #0B7566); box-shadow: 0 18rpx 38rpx rgba(14, 75, 68, .18); }
.home-hero::after { content: ''; position: absolute; width: 370rpx; height: 370rpx; right: -160rpx; top: 25rpx; border: 1rpx solid rgba(222, 255, 236, .19); border-radius: 50%; box-shadow: 0 0 0 52rpx rgba(222, 255, 236, .04), 0 0 0 106rpx rgba(222, 255, 236, .035); }
.home-brand { display: flex; align-items: center; font-size: 23rpx; font-weight: 600; color: #D9F4EB; }
.brand-mark { display: flex; align-items: center; justify-content: center; width: 38rpx; height: 38rpx; margin-right: 14rpx; border-radius: 11rpx; color: #123A3B; background: #B8F2D4; font-weight: 800; }
.home-headline { position: relative; z-index: 1; margin-top: 54rpx; font-size: 60rpx; line-height: 1.24; font-weight: 700; letter-spacing: 2rpx; }
.home-lead { position: relative; z-index: 1; max-width: 510rpx; margin-top: 20rpx; color: #D7EFE8; font-size: 26rpx; line-height: 1.65; }
.hero-metrics { display: flex; align-items: center; margin-top: 44rpx; padding-top: 25rpx; border-top: 1rpx solid rgba(234, 255, 247, .22); }
.hero-metric { display: flex; align-items: baseline; }
.metric-number { font-size: 39rpx; font-weight: 700; color: #C6F6DD; }
.metric-label { margin-left: 10rpx; font-size: 22rpx; color: #D8EFE7; }
.metric-divider { width: 1rpx; height: 31rpx; margin: 0 25rpx; background: rgba(234, 255, 247, .25); }
.home-section-heading { display: flex; align-items: flex-end; justify-content: space-between; margin: 46rpx 5rpx 22rpx; }
.home-eyebrow { font-size: 19rpx; color: #078C7D; font-weight: 700; letter-spacing: 3rpx; }
.home-section-title { margin-top: 8rpx; font-size: 35rpx; color: #163731; font-weight: 700; }
.section-index { font-size: 23rpx; color: #8AA49A; }
.start-card { border-radius: 28rpx; background: #DFF3E9; padding: 31rpx; border: 1rpx solid #C7E8D8; }
.start-card-top { display: flex; justify-content: space-between; align-items: center; }
.start-icon { display: flex; align-items: center; justify-content: center; width: 72rpx; height: 72rpx; border-radius: 21rpx; background: #087C70; color: #fff; font-size: 49rpx; }
.start-badge { border-radius: 999rpx; background: #fff; color: #087C70; padding: 7rpx 17rpx; font-size: 22rpx; font-weight: 600; }
.start-title { margin-top: 24rpx; font-size: 36rpx; font-weight: 700; color: #123D36; }
.start-desc { margin-top: 10rpx; font-size: 25rpx; line-height: 1.65; color: #4A6D61; }
.start-action { display: flex; justify-content: space-between; align-items: center; margin-top: 25rpx; border-top: 1rpx solid #BDDDCE; padding-top: 20rpx; color: #076F65; font-weight: 700; font-size: 26rpx; }
.start-action text { font-size: 34rpx; }
.home-actions { display: flex; margin-top: 18rpx; }
.action-tile { position: relative; box-sizing: border-box; width: 50%; min-height: 200rpx; padding: 22rpx; border-radius: 24rpx; background: #fff; border: 1rpx solid #E6EEE9; }
.action-tile:first-child { margin-right: 18rpx; }
.tile-icon { font-size: 34rpx; color: #0B897C; }
.tile-title { margin-top: 16rpx; font-size: 28rpx; font-weight: 700; }
.tile-sub { margin-top: 8rpx; padding-right: 12rpx; font-size: 21rpx; color: #71877D; line-height: 1.4; }
.tile-arrow { position: absolute; right: 21rpx; top: 22rpx; color: #93BBA8; font-size: 25rpx; }
.scene-heading { margin-top: 54rpx; }
.scene-card { display: flex; margin-bottom: 12rpx; padding: 24rpx 22rpx; background: #fff; border: 1rpx solid #E8EFEA; border-radius: 21rpx; }
.scene-number { margin-right: 25rpx; color: #0D9B85; font-size: 24rpx; font-weight: 700; }
.scene-content { flex: 1; }
.scene-title { font-size: 27rpx; font-weight: 700; }
.scene-desc { margin-top: 8rpx; color: #687D73; font-size: 23rpx; line-height: 1.6; }
.home-foot-card { display: flex; margin-top: 37rpx; padding: 27rpx; background: #FFF8E9; border-radius: 22rpx; }
.foot-accent { flex: none; width: 7rpx; margin-right: 18rpx; border-radius: 10rpx; background: #ECAF56; }
.foot-title { font-weight: 700; font-size: 27rpx; margin-bottom: 8rpx; }
