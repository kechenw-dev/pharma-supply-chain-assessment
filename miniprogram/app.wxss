page { background: #F5F8FA; color: #17324D; font-size: 30rpx; }
.page { min-height: 100vh; padding: 32rpx; box-sizing: border-box; }
.hero { background: #123B58; color: #fff; border-radius: 28rpx; padding: 42rpx 36rpx; margin-bottom: 28rpx; }
.hero-title { font-size: 42rpx; font-weight: 700; line-height: 1.35; }
.hero-sub { font-size: 26rpx; opacity: .88; line-height: 1.6; margin-top: 18rpx; }
.card { background: #fff; border-radius: 24rpx; padding: 30rpx; margin-bottom: 24rpx; box-shadow: 0 8rpx 28rpx rgba(21, 50, 72, .06); }
.section-title { font-size: 34rpx; font-weight: 700; margin: 8rpx 0 22rpx; }
.muted { color: #6B7D8D; font-size: 25rpx; line-height: 1.6; }
.body { line-height: 1.7; }
.tag { display: inline-block; color: #177A76; background: #E8F6F3; border-radius: 999rpx; padding: 6rpx 18rpx; font-size: 22rpx; margin: 0 12rpx 10rpx 0; }
.btn-primary { background: #0F766E; color: #fff; border-radius: 16rpx; font-weight: 600; margin: 24rpx 0 0; }
.btn-secondary { background: #E7F0F2; color: #123B58; border-radius: 16rpx; margin: 20rpx 0 0; }
.btn-plain { background: transparent; color: #0F766E; border: 1rpx solid #0F766E; border-radius: 16rpx; margin: 20rpx 0 0; }
.field-label { display: block; font-size: 26rpx; font-weight: 600; margin: 18rpx 0 10rpx; }
.field-input, .field-textarea { border: 1rpx solid #DCE5EA; background: #FBFCFD; border-radius: 14rpx; padding: 20rpx; box-sizing: border-box; width: 100%; font-size: 28rpx; }
.field-textarea { min-height: 170rpx; }
.error { color: #B42318; font-size: 25rpx; margin: 12rpx 0; }
.divider { height: 1rpx; background: #E7ECEF; margin: 24rpx 0; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.footer-note { font-size: 23rpx; color: #738391; line-height: 1.65; margin: 20rpx 0 50rpx; }
