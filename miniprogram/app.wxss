page { background: #F3F7F8; color: #193648; font-size: 29rpx; }
.page { min-height: 100vh; box-sizing: border-box; padding: 28rpx 28rpx 56rpx; }
.hero { margin-bottom: 27rpx; padding: 41rpx 35rpx; border-radius: 29rpx; background: linear-gradient(145deg, #12233B, #105469); color: #fff; box-shadow: 0 16rpx 34rpx rgba(22, 56, 79, .14); }
.hero-title { font-size: 42rpx; font-weight: 700; line-height: 1.35; }
.hero-sub { margin-top: 17rpx; color: #C5DEE5; font-size: 26rpx; line-height: 1.6; }
.card { margin-bottom: 22rpx; padding: 29rpx; border: 1rpx solid #E1EAEC; border-radius: 23rpx; background: #fff; box-shadow: 0 7rpx 24rpx rgba(26, 57, 74, .04); }
.section-title { margin: 6rpx 0 20rpx; color: #193648; font-size: 33rpx; font-weight: 700; }
.muted { color: #687E87; font-size: 25rpx; line-height: 1.65; }
.body { line-height: 1.7; }
.tag { display: inline-block; margin: 0 12rpx 10rpx 0; padding: 7rpx 18rpx; border-radius: 999rpx; background: #E6F6F7; color: #087D87; font-size: 22rpx; }
button::after { border: 0; }
.btn-primary { margin: 24rpx 0 0; border-radius: 16rpx; background: #0B8995; color: #fff; font-weight: 600; box-shadow: 0 8rpx 19rpx rgba(11, 137, 149, .16); }
.btn-secondary { margin: 20rpx 0 0; border-radius: 16rpx; background: #E5F4F5; color: #116B77; font-weight: 600; }
.btn-plain { margin: 20rpx 0 0; border: 1rpx solid #B8DCE0; border-radius: 16rpx; background: #fff; color: #087D87; }
.field-label { display: block; margin: 19rpx 0 10rpx; font-size: 26rpx; font-weight: 600; }
.field-input, .field-textarea { box-sizing: border-box; width: 100%; padding: 20rpx; border: 1rpx solid #D9E6E8; border-radius: 14rpx; background: #FAFCFC; color: #193648; font-size: 28rpx; }
.field-textarea { min-height: 170rpx; }
.error { margin: 12rpx 0; color: #B24534; font-size: 25rpx; }
.divider { height: 1rpx; margin: 24rpx 0; background: #E7EEEF; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.footer-note { margin: 22rpx 0 48rpx; color: #778B92; font-size: 23rpx; line-height: 1.65; }
